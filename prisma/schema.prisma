// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  name      String
  email     String   @unique
  imageUrl  String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customDesigns CustomDesign[]
  cart          Cart?
  orders        Order[]
}

enum Role {
  USER
  ADMIN
}

model Product {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  description    String
  basePrice      Float
  thumbnail      String?
  isFeatured     Boolean  @default(false)
  isCustomizable Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variants      ProductVariant[]
  customDesigns CustomDesign[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  images        ProductImage[]
  colors ProductColor[]
}


model ProductVariant {
  id              String  @id @default(uuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  size            Size
  color           String  // matches a ProductColor.name for this product — see note below
  stockQuantity   Int
  priceAdjustment Float

  @@unique([productId, size, color])
}

enum Size { 
  S
  M
  L
  XL
  XXL
}
// enum Color removed — colors are now admin-defined per product, see ProductColor

model ProductColor {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String   // e.g. "Black", "Forest Green" — free text, admin's choice
  hex          String   // swatch color shown in the UI, e.g. "#111111"
  frontMockup  String?  // studio blank-shirt front image — only used if product.isCustomizable
  backMockup   String?  // studio blank-shirt back image — only used if product.isCustomizable
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([productId, name])
  @@index([productId])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  colorName String?  // tags this photo to one of the product's colors; null = shown for every color
  createdAt DateTime @default(now())

  @@index([productId])
}

model CustomDesign {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  uploadedImageUrl String?
  frontDesignUrl   String?
  backDesignUrl    String?
  selectedColor    String   // was Color enum — now the ProductColor.name at time of order
  selectedSize     Size
  createdAt        DateTime @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  items CartItem[]
}

model CartItem {
  id             String        @id @default(uuid())
  cartId         String
  cart           Cart          @relation(fields: [cartId], references: [id])
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  customDesignId String?
  customDesign   CustomDesign? @relation(fields: [customDesignId], references: [id])
  quantity       Int           @default(1)
  unitPrice      Float
}

model Order {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  subtotal        Float
  totalAmount     Float
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(PROCESSING)
  shippingAddress String
  trackingId      String?
  createdAt       DateTime      @default(now())

  items OrderItem[]
}

model OrderItem {
  id             String        @id @default(uuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  customDesignId String?
  customDesign   CustomDesign? @relation(fields: [customDesignId], references: [id])
  quantity       Int
  price          Float
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  PROCESSING
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
}

// Singleton row holding store-wide, admin-editable pricing.
// Used for plain custom-printed shirts: basePrice + (printChargePerSide * sides printed).
model StoreSettings {
  id                   String   @id @default("singleton")
  customShirtBasePrice Float    @default(150)
  printChargePerSide   Float    @default(15)
  updatedAt            DateTime @updatedAt
}
